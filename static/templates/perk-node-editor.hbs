<div class="perk-node-editor-container">
	<div class="editor-content">
		<div class="form-group">
			<label>Perk Name</label>
			<div class="form-fields">
				<input type="text" name="name" value="{{node.name}}" placeholder="Perk Name" required>
			</div>
		</div>

		<div class="form-group">
			<label>Downtime Point Cost</label>
			<div class="form-fields">
				<input type="number" name="cost" value="{{node.cost}}" min="0" step="1">
			</div>
		</div>

		<div class="form-group">
			<label>Perk Icon</label>
			<div class="form-fields">
				<input type="text" name="icon" value="{{node.icon}}" placeholder="icons/svg/book.svg">
				<button type="button" class="file-picker-btn" data-action="pick-icon" title="Choose Icon">
					<i class="fas fa-file-import"></i>
				</button>
			</div>
		</div>

		<div class="form-group stacked">
			<label>Description</label>
			<div class="form-fields">
				<textarea name="description" placeholder="A brief explanation of the perk benefits...">{{node.description}}</textarea>
			</div>
		</div>

		{{#if other_nodes.length}}
		<div class="form-group stacked">
			<label>Prerequisites (Requires)</label>
			<div class="requirements-checkbox-list">
				{{#each other_nodes}}
				<label class="checkbox-label">
					<input type="checkbox" name="requirements" value="{{this.id}}" {{#if this.selected}}checked{{/if}}>
					<span>{{this.name}}</span>
				</label>
				{{/each}}
			</div>
		</div>
		{{/if}}

		<div class="form-group">
			<label>Roll Check</label>
			<div class="form-fields">
				<select name="roll_check">
					<option value="">None</option>
					<optgroup label="Abilities (Stats)">
						{{#each roll_choices.abilities}}
						<option value="{{this.id}}" {{#if (eq this.id ../node.roll_check)}}selected{{/if}}>{{this.name}}</option>
						{{/each}}
					</optgroup>
					<optgroup label="Skills">
						{{#each roll_choices.skills}}
						<option value="{{this.id}}" {{#if (eq this.id ../node.roll_check)}}selected{{/if}}>{{this.name}}</option>
						{{/each}}
					</optgroup>
					<optgroup label="Tools">
						{{#each roll_choices.tools}}
						<option value="{{this.id}}" {{#if (eq this.id ../node.roll_check)}}selected{{/if}}>{{this.name}}</option>
						{{/each}}
					</optgroup>
				</select>
			</div>
		</div>

		<div class="form-group">
			<label>Target DC</label>
			<div class="form-fields">
				<input type="number" name="dc" value="{{node.dc}}" min="0" step="1">
			</div>
		</div>

		<div class="form-group">
			<label>Trigger Macro</label>
			<div class="form-fields">
				<select name="macro_id">
					{{selectOptions macros selected=node.macro_id nameAttr="id" labelAttr="name" blank="None"}}
				</select>
			</div>
		</div>

		<div class="form-group">
			<label>Active Effect Reward</label>
			<div class="form-fields">
				{{#if node.effect}}
				<span style="font-size: 0.8rem; color: #10b981; font-weight: 700; display: inline-flex; align-items: center; gap: 4px; padding-right: 8px;">
					<i class="fas fa-check-circle"></i> Configured ({{node.effect.name}})
				</span>
				<button type="button" class="effect-control-btn" data-action="edit-effect" title="Edit Active Effect">
					<i class="fas fa-edit"></i> Edit
				</button>
				<button type="button" class="effect-control-btn" data-action="remove-effect" title="Remove Active Effect" style="color: #f87171 !important;">
					<i class="fas fa-trash-alt"></i> Remove
				</button>
				{{else}}
				<button type="button" class="effect-control-btn" data-action="create-effect" style="flex: 1 !important; width: auto !important;">
					<i class="fas fa-plus"></i> Configure Active Effect
				</button>
				{{/if}}
			</div>
		</div>

		<div class="form-group stacked">
			<label>Awarded Items / Features</label>
			<div class="drop-slot perk-items-slot" style="min-height: 54px; padding: 8px; border: 1px dashed rgba(255,255,255,0.2); border-radius: 4px; background: rgba(0,0,0,0.2);">
				{{#if node.items.length}}
				<div class="craft-slot-items" style="display: flex; flex-direction: column; gap: 4px;">
					{{#each node.items}}
					<div class="craft-slot-item" style="display: flex; align-items: center; gap: 8px; background: rgba(255,255,255,0.05); padding: 4px 8px; border-radius: 4px;">
						<img class="craft-ing-img" src="{{this.img}}" alt="{{this.name}}" style="width: 24px; height: 24px; border: none; border-radius: 3px;">
						<span class="craft-ing-name" style="flex: 1; font-size: 0.85rem; font-weight: 600; color: #f4f4f5;">{{this.name}}</span>
						<input type="number" class="craft-qty-input" value="{{this.quantity}}" min="1" style="width: 50px; text-align: center; height: 24px; font-size: 0.8rem;"
							data-action="edit-item-qty"
							data-item-uuid="{{this.uuid}}">
						<button type="button" class="craft-remove-btn" data-action="remove-item" data-item-uuid="{{this.uuid}}" style="border: none; background: transparent; color: #ef4444; cursor: pointer; padding: 2px 6px;">
							<i class="fas fa-times"></i>
						</button>
					</div>
					{{/each}}
				</div>
				{{else}}
				<div class="craft-drop-hint" style="display: flex; align-items: center; justify-content: center; gap: 6px; color: #71717a; font-size: 0.8rem; padding: 8px 0;">
					<i class="fas fa-plus-circle"></i>
					<span>Drop items or features here to grant on unlock</span>
				</div>
				{{/if}}
			</div>
		</div>
	</div>

	<footer class="sheet-footer">
		<button type="button" data-action="save">
			<i class="fas fa-save"></i> Save Perk
		</button>
	</footer>
</div>
